{
  "name": "@tigu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api -c blue,green \"pnpm db:start\" \"pnpm dev:api\"",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "db:start": "tsx scripts/dev-db.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@tigu/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "fastify-type-provider-zod": "^2.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "concurrently": "^9.2.5",
    "embedded-postgres": "16.13.0-beta.17",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
