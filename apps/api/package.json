{
  "name": "@tigu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api -c blue,green \"pnpm db:start\" \"pnpm dev:api\"",
    "dev:api": "tsx scripts/wait-for-db.ts && tsx watch --clear-screen=false src/server.ts",
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.0",
    "@tigu/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^2.1.0",
    "nanoid": "^5.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "concurrently": "^9.2.5",
    "embedded-postgres": "16.13.0-beta.17",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
