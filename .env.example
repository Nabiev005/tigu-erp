# ---------- Common ----------
# NODE_ENV is not set here: Vite reads this file and would build React in dev mode.
# The API defaults to "development"; set NODE_ENV=production in the deploy environment.

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL (embedded-postgres, no Docker / no install) ----------
# `pnpm dev` starts a local PostgreSQL 16 from node_modules with these settings.
PG_PORT=5433
# Owner (superuser) — runs migrations
PG_USER=tigu
PG_PASSWORD=tigu
# Non-owner role the API connects as, so Row Level Security applies
PG_APP_USER=tigu_app
PG_APP_PASSWORD=tigu_app
PG_DATABASE=tigu
# Data directory, relative to apps/api
PG_DATA_DIR=.data/postgres
DATABASE_URL=postgresql://tigu_app:tigu_app@localhost:5433/tigu?schema=public
DATABASE_ADMIN_URL=postgresql://tigu:tigu@localhost:5433/tigu?schema=public

# ---------- Auth ----------
# Use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
OTP_SECRET=dev-otp-secret-change-me-0123456789abcdef
# Login / PIN / OTP attempts per 15 minutes per IP + phone (spec §13)
AUTH_RATE_LIMIT_MAX=5

# ---------- File storage ----------
# "local" stores files on disk (dev); "s3" will be added for production
STORAGE_DRIVER=local
# Relative to apps/api
STORAGE_DIR=.data/files

# ---------- Web (Vite) ----------
WEB_PORT=5173
# Where the Vite dev server proxies /api and /health
VITE_API_PROXY_TARGET=http://localhost:3000

# Serve not-yet-built API modules from MSW in the browser (auth, users, settings are real)
VITE_API_MOCKS=true
# Stage 2 modules (warehouse, quality, client portal)
VITE_FEATURE_STAGE2=false
