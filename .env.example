# ---------- Common ----------
# NODE_ENV is not set here: Vite reads this file and would build React in dev mode.
# The API defaults to "development"; set NODE_ENV=production in the deploy environment.

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL (embedded-postgres, no Docker / no install) ----------
# `pnpm dev` starts a local PostgreSQL 16 from node_modules with these settings.
PG_PORT=5433
PG_USER=tigu
PG_PASSWORD=tigu
PG_DATABASE=tigu
# Data directory, relative to apps/api
PG_DATA_DIR=.data/postgres
DATABASE_URL=postgresql://tigu:tigu@localhost:5433/tigu?schema=public

# ---------- File storage ----------
# "local" stores files on disk (dev); "s3" will be added for production
STORAGE_DRIVER=local
# Relative to apps/api
STORAGE_DIR=.data/files

# ---------- Web (Vite) ----------
WEB_PORT=5173
# Where the Vite dev server proxies /api and /health
VITE_API_PROXY_TARGET=http://localhost:3000

# Serve the API from MSW in the browser until backend modules exist (stage 2+)
VITE_API_MOCKS=true
# Stage 2 modules (warehouse, quality, client portal)
VITE_FEATURE_STAGE2=false
